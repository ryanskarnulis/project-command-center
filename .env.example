# Root .env for the docker-compose deployment. Copy to .env and fill in.
#   cp .env.example .env
# (The dev path via ./main.sh uses backend/.env and frontend/.env instead.)
#
# Container-specific values (DATABASE_URL, API_HOST) are set inside
# docker-compose.yml, not here.

# App label echoed at /health and on startup.
APP_ENV=production

# --- Dashboard exposure ----------------------------------------------------
# The dashboard is host-only by default: docker-compose.yml falls back to
# FRONTEND_BIND=127.0.0.1, and this example deliberately does NOT override it.
# The dashboard is unauthenticated, so binding it to all interfaces hands the
# whole single-user app to anything that can reach this host.
#
# LAN exposure is opt-in. Uncomment the line below when you want the dashboard
# reachable from other devices — e.g. the workspace gateway fronting
# tasks.$HOMELAB_DOMAIN → 127.0.0.1:8100 — and only on a trusted LAN. Host-only-
# write guarded routes (none today; future agent endpoints) treat proxied
# clients as untrusted once the dashboard is LAN-exposed.
# FRONTEND_BIND=0.0.0.0
#
# FRONTEND_PORT is the published host port (PCC owns the 8100-8199 block — see
# ../gateway/README.md).
FRONTEND_PORT=8100

# --- Reverse-proxy trust ---------------------------------------------------
# Comma-separated IPs/CIDRs identifying the nginx reverse proxy (the compose
# subnet). The backend uses this to recognize proxied requests for the write-guard
# and to key the rate limiter on the address nginx observed. Leave as-is unless
# you change the compose network subnet.
TRUSTED_PROXY_IPS=172.28.0.0/16

# --- Local model runtime (optional override) --------------------------------
# The backend container reaches the shared llama-swap proxy on the host
# (../llama-swap/, port 8200) via host.docker.internal; docker-compose.yml
# supplies that default and the extra_hosts mapping. Only set this to point
# somewhere else (e.g. another machine on the LAN).
# LLAMACPP_BASE_URL=http://host.docker.internal:8200/v1

# --- Voice / speech service (optional, off by default) ----------------------
# Voice is opt-in. Left unset — or set explicitly empty — the backend runs
# voiceless: /api/voice/* answers 503 and nothing else changes. Uncomment both
# to proxy the shared workspace speech service on the host (../speech/: Speaches
# STT on 8400, Kokoro-FastAPI TTS on 8410), reached via host.docker.internal
# (docker-compose.yml supplies the extra_hosts mapping).
# SPEECH_BASE_URL=http://host.docker.internal:8400/v1
# TTS_BASE_URL=http://host.docker.internal:8410/v1
# TTS_MODEL and TTS_VOICE default to the house Kokoro voice in
# docker-compose.yml; they only matter once the URLs above are set.

# --- Litestream off-host replica (optional) --------------------------------
# The litestream sidecar replicates data/app.db continuously. By default it
# writes a local file replica to data/replica/ (no cloud dependency). To
# replicate off-host instead, uncomment the s3 block in litestream.yml and set:
# LITESTREAM_S3_BUCKET=
# LITESTREAM_S3_ENDPOINT=            # omit/blank for AWS S3 proper
# LITESTREAM_S3_REGION=us-east-1
# LITESTREAM_S3_ACCESS_KEY_ID=
# LITESTREAM_S3_SECRET_ACCESS_KEY=
