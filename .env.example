# Root .env for the docker-compose deployment. Copy to .env and fill in.
#   cp .env.example .env
# (The dev path via ./main.sh uses backend/.env and frontend/.env instead.)
#
# Container-specific values (DATABASE_URL, API_HOST, OLLAMA_BASE_URL,
# BACKEND_BASE_URL) are set inside docker-compose.yml, not here.

# App label echoed at /health and on startup.
APP_ENV=production

# --- Dashboard exposure ----------------------------------------------------
# Host-only by default (mirrors API_HOST/DEV_HOST). While host-only, Settings
# writes work from the host. Set FRONTEND_BIND=0.0.0.0 to expose the dashboard on
# the LAN — that automatically re-guards Settings writes to 403 (see README).
# FRONTEND_PORT is the published host port.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# --- Reverse-proxy trust ---------------------------------------------------
# Comma-separated IPs/CIDRs identifying the nginx reverse proxy (the compose
# subnet). The backend uses this to recognize proxied requests for the write-guard
# and to key the rate limiter on the address nginx observed. Leave as-is unless
# you change the compose network subnet.
TRUSTED_PROXY_IPS=172.28.0.0/16

# --- Discord bot (optional; started with `--profile discord`) --------------
# Empty DISCORD_BOT_TOKEN → the bot exits immediately. Empty
# BACKEND_SHARED_SECRET → the /api/discord/* routes are disabled (503).
DISCORD_BOT_TOKEN=
BACKEND_SHARED_SECRET=
# Optional: a guild id for instant slash-command registration while testing.
DISCORD_GUILD_ID=

# --- Rate limits (per client/min on the Ollama-calling routes) -------------
# Uncomment to override the defaults baked into config.py.
# RATE_LIMIT_DISCORD_INBOX_PER_MIN=30
# RATE_LIMIT_SUMMARY_PER_MIN=20
# RATE_LIMIT_INBOX_PROCESS_PER_MIN=20
# RATE_LIMIT_BREAKDOWN_PER_MIN=20

# --- Litestream off-host replica (optional) --------------------------------
# The litestream sidecar replicates data/app.db continuously. By default it
# writes a local file replica to data/replica/ (no cloud dependency). To
# replicate off-host instead, uncomment the s3 block in litestream.yml and set:
# LITESTREAM_S3_BUCKET=
# LITESTREAM_S3_ENDPOINT=            # omit/blank for AWS S3 proper
# LITESTREAM_S3_REGION=us-east-1
# LITESTREAM_S3_ACCESS_KEY_ID=
# LITESTREAM_S3_SECRET_ACCESS_KEY=
