# App
APP_ENV=development
DATABASE_URL=sqlite:///../data/app.db
# API bind address. Default is loopback-only; set to 0.0.0.0 to expose on the LAN.
API_HOST=127.0.0.1

# Local model runtime: the shared llama-swap proxy (../llama-swap/, port 8200).
# Defaults below are baked into app/config.py — uncomment only to override.
# LLAMACPP_BASE_URL=http://127.0.0.1:8200/v1
# LLAMACPP_MODEL=gemma-4-12b
# LLAMACPP_TIMEOUT_SECONDS must be a positive, finite number of seconds.
# LLAMACPP_TIMEOUT_SECONDS=300

# Trash retention: days after deletion before the retention job permanently
# deletes trash (default 30; 0 = keep trash forever).
# TRASH_RETENTION_DAYS=30

# Agent run trace: one JSONL record per agent run (off when unset; see
# docs/agent-tracing.md). Relative paths resolve against backend/.
# PCC_TRACE_PATH=../data/traces/agent.jsonl

# Embeddings service for the agent's pre-run gather (#415; ../embeddings/).
# Unset = keyword matches alone. The cache file is optional (memory only).
# EMBEDDINGS_BASE_URL=http://127.0.0.1:8600/v1
# EMBEDDINGS_CACHE_PATH=../data/embeddings_cache.json

# Agent context capture: every model call's exact bytes and rendered prompt
# (off when unset; heavy; see docs/agent-context-capture.md).
# PCC_CONTEXT_PATH=../data/traces/context.jsonl
