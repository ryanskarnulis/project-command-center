# App
APP_ENV=development
DATABASE_URL=sqlite:///../data/app.db
# API bind address. Default is loopback-only; set to 0.0.0.0 to expose on the LAN.
# Settings reads may be visible from LAN clients, but settings writes stay
# localhost-only because they mutate local files and can run evals.
API_HOST=127.0.0.1

# AI
OLLAMA_BASE_URL=http://localhost:11434
# How long Ollama keeps the model loaded after a request. Short default ("2m")
# because the GPU is shared with other model servers; "-1" = keep forever.
OLLAMA_KEEP_ALIVE=2m

# Discord (Sprint 3). BACKEND_SHARED_SECRET must be set to enable the
# /api/discord/inbox route (empty = route disabled). The bot uses
# DISCORD_BOT_TOKEN and reaches the API at BACKEND_BASE_URL.
DISCORD_BOT_TOKEN=
BACKEND_SHARED_SECRET=
BACKEND_BASE_URL=http://127.0.0.1:8000
# Optional: set to your server's ID for instant /inbox registration while testing
# (global sync can take ~an hour). Right-click the server icon → Copy Server ID
# (needs Developer Mode: User Settings → Advanced → Developer Mode).
DISCORD_GUILD_ID=
